generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  // Short handle set by HR/Admin, used to log in — distinct from `name`
  // (the full display name). Nullable so existing accounts created before
  // this field existed keep working via email until an admin sets one.
  username        String?  @unique
  // Optional now — HR/Admin can create a new hire with just a Name and
  // password, and add their email later from Staff Directory.
  email           String?  @unique
  passwordHash    String
  department      String?
  designation     String?
  isActive        Boolean  @default(true)
  activeSessionId String?
  // Monthly basic salary — the single source of truth for pay. Hourly rate
  // (÷26 working days ÷8 hours) and daily rate (÷26) are always derived from
  // this rather than entered separately, so normal pay and every OT formula
  // stay consistent with each other. See lib/payroll.ts.
  basicSalary     Float?
  // Whether this person can log OT hours on their timesheet at all — most
  // staff (e.g. salaried without OT entitlement) shouldn't see the option.
  otEligible      Boolean  @default(false)
  // Annual Leave days entitled for the current year, and unused days
  // manually carried forward from the previous year (HR re-enters both at
  // the start of each year — mirrors the Ent./B/f columns HR already
  // maintains by hand, so no automated year-end rollover is needed). See
  // lib/leave-balance.ts. Null entitlement means unset, not zero.
  annualLeaveEntitlement     Float?
  annualLeaveBroughtForward  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdEvents      Event[]          @relation("EventCreatedBy")
  eventAttendees     EventAttendee[]
  signInRecords      SignInRecord[]
  announcements      Announcement[]
  announcementReceipts AnnouncementRecipient[]
  timesheetEntries   TimesheetEntry[]
  projectMemberships ProjectMember[]

  // Leave approval groups: an employee can belong to more than one (e.g. a
  // department group and a project group), and picks which one to route a
  // given application through at apply time. A group's director is whoever
  // approves/rejects that group's leave applications. Kept independent of
  // `department` on purpose — a director's reports don't necessarily match
  // a department boundary.
  leaveGroupMemberships LeaveGroupMember[]
  directedLeaveGroups   LeaveGroup[]       @relation("LeaveGroupDirector")
  // The architect is the first-stage approver for a group's leave
  // applications — a director only sees an application after the group's
  // architect has already signed off on it. Optional: a group with no
  // architect assigned skips straight to the director stage.
  architectedLeaveGroups LeaveGroup[]       @relation("LeaveGroupArchitect")
  leaveApplications     LeaveApplication[] @relation("LeaveApplicant")
  reviewedLeaveApplications LeaveApplication[] @relation("LeaveReviewer")
  architectApprovedLeaveApplications LeaveApplication[] @relation("LeaveArchitectApprover")
  notifications         Notification[]
  // Notification `type` values (see lib/notification-types.ts) this user has
  // opted out of — notifyUsers() skips creating a row for a muted type
  // rather than creating it read, so it never counts toward unread history.
  mutedNotificationTypes String[] @default([])

  @@index([department])
  @@index([roleId])
}

model LeaveGroup {
  id         String   @id @default(cuid())
  name       String   @unique
  directorId String
  director   User     @relation("LeaveGroupDirector", fields: [directorId], references: [id])
  // First-stage approver — see the comment on User.architectedLeaveGroups.
  architectId String?
  architect   User?    @relation("LeaveGroupArchitect", fields: [architectId], references: [id])
  memberships LeaveGroupMember[]
  applications LeaveApplication[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Join table for User<->LeaveGroup membership — an employee can be a member
// of several groups (e.g. their department's group and a project group),
// unlike the single architect/director roles which are one-per-group.
model LeaveGroupMember {
  id           String     @id @default(cuid())
  leaveGroupId String
  leaveGroup   LeaveGroup @relation(fields: [leaveGroupId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([leaveGroupId, userId])
  @@index([userId])
}

model LeaveApplication {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("LeaveApplicant", fields: [userId], references: [id])
  leaveType      String
  startDate      DateTime
  endDate        DateTime
  // FULL | AM | PM — AM/PM only valid when startDate == endDate (half-day
  // is single-day only) and only for HALF_DAY_ELIGIBLE_LEAVE_TYPES.
  dayPortion     String    @default("FULL")
  reason         String?
  // Optional — which project this leave affects the schedule for, shown to
  // approvers alongside the leave type/dates for context.
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  // Which of the applicant's (possibly several) leave groups this specific
  // application was routed through — chosen by the applicant at submission
  // time, since membership in more than one group makes "the" group
  // ambiguous otherwise. Drives which architect/director gets notified and
  // is authorized to act on it. Null for an applicant with no group.
  leaveGroupId   String?
  leaveGroup     LeaveGroup? @relation(fields: [leaveGroupId], references: [id])
  // PENDING_ARCHITECT | PENDING_DIRECTOR | APPROVED | REJECTED. A group with
  // no architect assigned starts straight at PENDING_DIRECTOR.
  status         String    @default("PENDING_DIRECTOR")
  // Stage 1: set only when the architect approves and passes the
  // application on to the director — an architect rejection is terminal
  // and recorded in reviewedBy*/reviewedAt below instead, same as a
  // director's decision.
  architectApprovedById   String?
  architectApprovedByName String?
  architectRemarks        String?
  architectApprovedAt     DateTime?
  // Terminal decision — whoever made the final call (architect reject,
  // director reject, or director approve).
  reviewedById   String?
  reviewedByName String?
  reviewRemarks  String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviewedBy         User? @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  architectApprovedBy User? @relation("LeaveArchitectApprover", fields: [architectApprovedById], references: [id])

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  label       String
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Project {
  id          String    @id @default(cuid())
  code        String    @unique
  shortName   String    @default("")
  title       String
  status      String    @default("Active")
  access      String    @default("Team")
  offices     String[]  @default([])
  client      String?
  description String?
  startDate   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // The fields below are populated when importing from the firm's historical
  // "Projects List" register (job-number ledger going back decades) via
  // parseProjectsListWorkbook / the Projects List import — left null for
  // projects created normally through the app.
  jobNo           String?
  phase           String?
  scopeOfWorks    String?
  address         String?
  state           String?
  country         String?
  mainTypology    String?
  subTypology     String?
  designInCharge  String?
  siteArea        Float?
  gfa             Float?
  noOfFloors      Int?
  noOfUnits       Int?
  certification   String?

  events           Event[]
  timesheetEntries TimesheetEntry[]
  members          ProjectMember[]
  leaveApplications LeaveApplication[]
}

// Dates HR has designated as public holidays — cross-referenced against
// TimesheetEntry.date to apply the public-holiday OT rate (see
// lib/payroll.ts) instead of the weekday/Saturday/Sunday ones.
model PublicHoliday {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  name      String
  // Recurs every year on the same month/day range (e.g. Merdeka Day) rather
  // than being tied to the specific year it was entered for (e.g. Hari Raya,
  // which shifts dates yearly on the Islamic calendar).
  recurring Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([startDate, endDate])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Venue {
  id             String  @id @default(cuid())
  description    String
  collisionCheck Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events Event[]
}

model Event {
  id            String    @id @default(cuid())
  title         String
  date          DateTime
  durationMins  Int?
  stage         String?
  task          String?
  externalVenue String?
  resources     String?
  remarks       String?
  repeat        Boolean   @default(false)
  private       Boolean   @default(false)
  remindMe      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  venueId   String?
  venue     Venue?   @relation(fields: [venueId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  attendees EventAttendee[]

  @@index([date])
}

model EventAttendee {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model SignInRecord {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  signInAt  DateTime  @default(now())
  signOutAt DateTime?

  @@index([userId, signInAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments AnnouncementAttachment[]
  // No rows here means company-wide — everyone can see it. One or more
  // rows means only those specific people (plus anyone with
  // MANAGE_ANNOUNCEMENTS, for oversight) can see it.
  recipients  AnnouncementRecipient[]

  @@index([createdAt])
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
}

model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  fileName       String
  storagePath    String
  fileSize       Int
  createdAt      DateTime     @default(now())
}

model OrgSettings {
  id             String   @id @default("singleton")
  officeLat      Float?
  officeLng      Float?
  officeRadiusM  Int      @default(200)
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  url       String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PasswordResetRequest {
  id             String    @id @default(cuid())
  email          String
  userId         String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedByName String?

  @@index([status, createdAt])
}

model TimesheetEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime
  eventType  String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  stage      String?
  task       String?
  normalMins Int      @default(0)
  otMins     Int      @default(0)
  // Snapshot of the submitter's Basic Salary at the moment this entry was
  // created — cost calculations use this instead of the user's current
  // Basic Salary, so a later raise/pay cut doesn't retroactively change the
  // computed cost of past entries. Null on rows created before this field
  // existed; those fall back to the user's current salary.
  basicSalaryAtEntry Float?
  // Minutes since midnight, local time. Optional and independent of
  // normalMins/otMins (which drive payroll hours) — these are purely so the
  // Activities Summary Gantt chart can place the entry on a timeline.
  startMins  Int?
  endMins    Int?
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, date])
}
