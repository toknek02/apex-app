generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  // Short handle set by HR/Admin, used to log in — distinct from `name`
  // (the full display name). Nullable so existing accounts created before
  // this field existed keep working via email until an admin sets one.
  username        String?  @unique
  // Optional now — HR/Admin can create a new hire with just a Name and
  // password, and add their email later from Staff Directory.
  email           String?  @unique
  passwordHash    String
  department      String?
  designation     String?
  isActive        Boolean  @default(true)
  activeSessionId String?
  hourlyRate      Float?
  otRate          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdEvents      Event[]          @relation("EventCreatedBy")
  eventAttendees     EventAttendee[]
  signInRecords      SignInRecord[]
  announcements      Announcement[]
  announcementReceipts AnnouncementRecipient[]
  timesheetEntries   TimesheetEntry[]
  projectMemberships ProjectMember[]

  // Leave approval groups: each employee belongs to at most one group, and
  // a group's director is whoever approves/rejects that group's leave
  // applications. Kept independent of `department` on purpose — a
  // director's reports don't necessarily match a department boundary.
  leaveGroupId          String?
  leaveGroup            LeaveGroup?        @relation("LeaveGroupMembers", fields: [leaveGroupId], references: [id])
  directedLeaveGroups   LeaveGroup[]       @relation("LeaveGroupDirector")
  leaveApplications     LeaveApplication[] @relation("LeaveApplicant")
  reviewedLeaveApplications LeaveApplication[] @relation("LeaveReviewer")
  notifications         Notification[]
  // Notification `type` values (see lib/notification-types.ts) this user has
  // opted out of — notifyUsers() skips creating a row for a muted type
  // rather than creating it read, so it never counts toward unread history.
  mutedNotificationTypes String[] @default([])

  @@index([department])
  @@index([roleId])
  @@index([leaveGroupId])
}

model LeaveGroup {
  id         String   @id @default(cuid())
  name       String   @unique
  directorId String
  director   User     @relation("LeaveGroupDirector", fields: [directorId], references: [id])
  members    User[]   @relation("LeaveGroupMembers")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LeaveApplication {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("LeaveApplicant", fields: [userId], references: [id])
  leaveType      String
  startDate      DateTime
  endDate        DateTime
  // FULL | AM | PM — AM/PM only valid when startDate == endDate (half-day
  // is single-day only) and only for HALF_DAY_ELIGIBLE_LEAVE_TYPES.
  dayPortion     String    @default("FULL")
  reason         String?
  // PENDING | APPROVED | REJECTED
  status         String    @default("PENDING")
  reviewedById   String?
  reviewedByName String?
  reviewRemarks  String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  label       String
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Project {
  id          String    @id @default(cuid())
  code        String    @unique
  shortName   String    @default("")
  title       String
  status      String    @default("Active")
  access      String    @default("Team")
  offices     String[]  @default([])
  client      String?
  description String?
  startDate   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events           Event[]
  timesheetEntries TimesheetEntry[]
  members          ProjectMember[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Venue {
  id             String  @id @default(cuid())
  description    String
  collisionCheck Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events Event[]
}

model Event {
  id            String    @id @default(cuid())
  title         String
  date          DateTime
  durationMins  Int?
  stage         String?
  task          String?
  externalVenue String?
  resources     String?
  remarks       String?
  repeat        Boolean   @default(false)
  private       Boolean   @default(false)
  remindMe      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  venueId   String?
  venue     Venue?   @relation(fields: [venueId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  attendees EventAttendee[]

  @@index([date])
}

model EventAttendee {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model SignInRecord {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  signInAt  DateTime  @default(now())
  signOutAt DateTime?

  @@index([userId, signInAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments AnnouncementAttachment[]
  // No rows here means company-wide — everyone can see it. One or more
  // rows means only those specific people (plus anyone with
  // MANAGE_ANNOUNCEMENTS, for oversight) can see it.
  recipients  AnnouncementRecipient[]

  @@index([createdAt])
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
}

model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  fileName       String
  storagePath    String
  fileSize       Int
  createdAt      DateTime     @default(now())
}

model OrgSettings {
  id             String   @id @default("singleton")
  officeLat      Float?
  officeLng      Float?
  officeRadiusM  Int      @default(200)
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  url       String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PasswordResetRequest {
  id             String    @id @default(cuid())
  email          String
  userId         String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedByName String?

  @@index([status, createdAt])
}

model TimesheetEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime
  eventType  String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  stage      String?
  task       String?
  normalMins Int      @default(0)
  otMins     Int      @default(0)
  // Minutes since midnight, local time. Optional and independent of
  // normalMins/otMins (which drive payroll hours) — these are purely so the
  // Activities Summary Gantt chart can place the entry on a timeline.
  startMins  Int?
  endMins    Int?
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, date])
}
