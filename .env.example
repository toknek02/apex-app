DATABASE_URL="postgresql://apex_user:replace-with-password@localhost:5432/apex_db"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Leave AUTH_URL unset — trustHost: true in lib/auth.ts derives the origin from each
# request instead, so auth keeps working when the app is reached via different hosts/IPs
# (LAN IP, localhost, a phone on a different network). Only set AUTH_URL if you deploy
# behind a single fixed public domain and want to pin it explicitly.
# Optional — where announcement file attachments are stored on disk. Defaults to <project>/storage.
# APEX_STORAGE_ROOT="D:/APEX_STORAGE"
